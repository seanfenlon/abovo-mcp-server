{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.seanfenlon/abovo-mcp-server",
  "title": "ABOVO.co — Email-to-Web Publishing",
  "description": "Publish content to the web by emailing POST@abovo.co. No API key, no signup. SMTP is the API.",
  "version": "1.1.1",
  "websiteUrl": "https://www.abovo.co",
  "repository": {
    "url": "https://github.com/seanfenlon/abovo-mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/seanfenlon/abovo-mcp-server/releases/download/v1.1.1/abovo-mcp-server-1.1.1.mcpb",
      "version": "1.1.1",
      "fileSha256": "06865bc4d1e837dbc15e5c03ea242364c1e27bcb61f230c8d9ad547c5a03863c",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ABOVO_SMTP_USER",
          "description": "SMTP username / sending email address",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "ABOVO_SMTP_PASS",
          "description": "SMTP password or app password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "ABOVO_SMTP_HOST",
          "description": "SMTP hostname (default: smtp.gmail.com)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "ABOVO_SMTP_PORT",
          "description": "SMTP port (default: 587)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "ABOVO_SENDER_EMAIL",
          "description": "From address (defaults to ABOVO_SMTP_USER)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
