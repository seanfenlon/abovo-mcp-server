{
  "name": "@seanfenlon/abovo-mcp-server",
  "version": "1.1.1",
  "type": "module",
  "bin": {
    "abovo-mcp-server": "dist/stdio.cjs"
  },
  "files": [
    "dist/",
    "src/",
    "build.ts",
    "README.md",
    ".mcp/"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "prepublishOnly": "echo \"ERROR: do not run npm publish from artifacts/api-server — the dev manifest uses pnpm-only workspace/catalog protocols and is uninstallable via npm. Run: tsx ./build.ts && tsx ./stage-publish.ts, then publish from publish-staging/ instead.\" >&2 && exit 1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/api-zod": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "nodemailer": "^6.10.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
